# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.git
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# content-collections cache (generated output is committed)
.content-collections/cache/

# auto-generated post images (generated by npm run generate)
/public/posts/

# production
/build

# fumadocs-mdx 生成的索引与构建产物，CI 中自动生成
.source/

# react-router framework mode 生成的类型
/.react-router/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# wrangler / Cloudflare
.wrangler/

# edgeone
.edgeone/
*.zip

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright test artifacts
.playwright-mcp/
*-page-snapshot

# 本地 AI 工具配置，不入库
opencode.json

# 调试产物（截图 / 临时输出），非源码
/toc-initial.txt
/files-*.png
/self-host-cdn.png
/build-perf/

# 分域构建产物（每个业务一份）
/build-*/
